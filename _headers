# ============================================================
# _headers — Cloudflare Pages が返す「安全のための印」
# このファイルは、アプリのページを開いた時に、ブラウザへ安全の決まりを伝えるファイルです。
# ============================================================
# 全部のページに付ける
/*
  # ファイルの種類を勝手に変えて読まない
  X-Content-Type-Options: nosniff
  # ほかのサイトの中に埋め込ませない（だまし押しを防ぐ）
  X-Frame-Options: DENY
  # ほかのサイトへ移る時、URLのくわしい所を渡さない
  Referrer-Policy: strict-origin-when-cross-origin
  # カメラ・マイク・位置情報は使わない
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # 1年間は必ず https で開く
  Strict-Transport-Security: max-age=31536000
  # 読んでよい場所を決める（ほかのサイトのプログラムを動かされないように。2026年11月16日）
  #   プログラム … このサイトと、Supabase の道具（cdn.jsdelivr.net）だけ
  #   通信 … このサイト・Supabase・Cloudflare Worker だけ（Gemini には Worker を通してだけつなぐ）
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.workers.dev https://cdn.jsdelivr.net; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  # ほかのサイトの窓からは、このアプリを操作させない
  Cross-Origin-Opener-Policy: same-origin

# サービスワーカーと設定は、毎回新しいものを読む（古いアプリが残らないように）
# サービスワーカー
/sw.js
  # 毎回新しいものを確かめる
  Cache-Control: no-cache
# アプリの設定
/js/config.js
  # 毎回新しいものを確かめる
  Cache-Control: no-cache
